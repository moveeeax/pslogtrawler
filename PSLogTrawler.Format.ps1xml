<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>PSLogTrawler.LogSummary</Name>
      <ViewSelectedBy>
        <TypeName>PSLogTrawler.LogSummary</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Total</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Error</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Warn</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Info</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Debug</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>First</Label></TableColumnHeader>
          <TableColumnHeader><Label>Last</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Total</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Error</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Warn</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Info</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Debug</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>First</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Last</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>PSLogTrawler.RateBucket</Name>
      <ViewSelectedBy>
        <TypeName>PSLogTrawler.RateBucket</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Start</Label></TableColumnHeader>
          <TableColumnHeader><Label>Interval</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Count</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Rate</Label><Width>8</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Start</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Interval</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Count</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Rate</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

  </ViewDefinitions>
</Configuration>
